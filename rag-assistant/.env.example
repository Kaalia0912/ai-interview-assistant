# 复制本文件为 .env 后填写真实 key（.env 已被 .gitignore 忽略，不会提交）

# 生成模型：DeepSeek
DEEPSEEK_API_KEY=sk-在这里填
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 向量模型（Embedding）：通义 DashScope 和硅基流动二选一，用哪个就留哪一组

# 方案一：通义千问 DashScope（免费额度）
EMBED_API_KEY=sk-在这里填
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3

# 方案二：硅基流动 SiliconFlow（BAAI/bge-m3 免费，推荐）
# EMBED_API_KEY=sk-在这里填
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3

# 重排（可选，硅基流动 bge-reranker-v2-m3；不填则默认复用上面的向量 key/地址）
# RERANK_API_KEY=
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
